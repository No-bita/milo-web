{
  "name": "milo-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/landing-facts.mjs --check && vite build",
    "preview": "vite preview",
    "test": "node --test src/logic/*.test.mjs src/domain/*.test.mjs src/components/*.test.mjs",
    "test:regression": "npm run build && node --test --test-concurrency=1 src/tests/*.test.mjs",
    "test:all": "npm test && npm run test:regression",
    "facts": "node scripts/landing-facts.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "playwright": "1.64.0"
  }
}
